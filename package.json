{
  "name": "shipping-inspection",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "node ./node_modules/tsx/dist/cli.mjs prisma/seed.ts"
  },
  "scripts": {
    "postinstall": "node ./node_modules/prisma/build/index.js generate",
    "dev": "node ./scripts/run-next.mjs dev --webpack",
    "prebuild": "node ./node_modules/prisma/build/index.js generate",
    "build": "node ./scripts/run-next.mjs build --webpack",
    "start": "node ./scripts/run-next.mjs start --webpack",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "db:push": "node ./node_modules/prisma/build/index.js db push --skip-generate",
    "db:seed": "node ./node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "db:seed-bulk": "node ./node_modules/tsx/dist/cli.mjs prisma/seed-bulk.ts",
    "db:clean-demo": "node ./node_modules/tsx/dist/cli.mjs prisma/clean-demo.ts",
    "db:clean-current": "node ./node_modules/tsx/dist/cli.mjs prisma/clean-current.ts",
    "db:clean-audit-logs": "node ./node_modules/tsx/dist/cli.mjs prisma/clean-audit-logs.ts",
    "db:clean-bootstrap": "node ./node_modules/tsx/dist/cli.mjs prisma/clean-bootstrap.ts",
    "db:clean-bulk": "node ./node_modules/tsx/dist/cli.mjs prisma/clean-bulk.ts",
    "db:clean-all": "node ./node_modules/tsx/dist/cli.mjs prisma/clean-all.ts",
    "db:init-local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-local-postgres.ps1",
    "db:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/backup-db.ps1",
    "db:restore": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/restore-db.ps1",
    "db:migrate": "node ./node_modules/prisma/build/index.js migrate dev --skip-generate",
    "db:migrate:deploy": "node ./node_modules/prisma/build/index.js migrate deploy",
    "db:migrate:status": "node ./node_modules/prisma/build/index.js migrate status",
    "db:check": "node ./node_modules/tsx/dist/cli.mjs prisma/db-check.ts",
    "worker": "node ./node_modules/tsx/dist/cli.mjs scripts/worker.ts",
    "stress:documents": "node ./scripts/stress/run.mjs documents",
    "stress:dashboard": "node ./scripts/stress/run.mjs dashboard",
    "stress:daily-shipped": "node ./scripts/stress/run.mjs daily-shipped"
  },
  "dependencies": {
    "@prisma/client": "6.5.0",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "html5-qrcode": "^2.3.8",
    "next": "^16.2.1",
    "next-auth": "^5.0.0-beta.30",
    "node-cron": "^3.0.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "autocannon": "^8.0.0",
    "prisma": "6.5.0",
    "shadcn": "^4.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.3",
    "typescript": "^5"
  }
}
