# 複製為專案根目錄的 .env.docker.demo 後使用（勿 commit 真實密碼檔）
#   copy deploy\env.docker.demo.example .env.docker.demo
#
# 啟動：.\scripts\run-docker-demo.ps1

DB_PASSWORD=demo-db-change-me
AUTH_SECRET=demo-auth-change-me-use-openssl-rand
# 本機瀏覽：http://127.0.0.1:3000
# 區網同事：http://你的內網IP:3000
# Cloudflare Tunnel / ngrok：改成隧道給的 https 網址（無尾斜線）
AUTH_URL=http://127.0.0.1:3000

LOCK_TTL_MINUTES=5
SYNC_CRON_EXPRESSION=0 * * * *
ERP_API_URL=
ERP_DB_URL=

# seed 用（演示帳號密碼）
ADMIN_PASSWORD=demo-admin-2026
SEED_DEMO=YES
